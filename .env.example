# Naukri MCP Server — Remote access configuration
#
# Copy to .env and fill in real values. Never commit .env (it's gitignored).
# The server reads these env vars at startup.

# ============================================================================
# Network binding
# ============================================================================

# Set to 1 to bind 0.0.0.0 (public) instead of 127.0.0.1 (local-only).
# When MCP_REMOTE=1, the server REFUSES to start unless at least one auth mode
# (MCP_SHARED_SECRET or MCP_OAUTH_ENABLED) is enabled.
MCP_REMOTE=0

# Override default port 8321 if needed.
MCP_PORT=8321

# Public URL of this server — used as OAuth issuer / resource identifier.
# Example: https://naukri.example.com
# Leave commented for local development (defaults to http://localhost:8321).
# MCP_PUBLIC_URL=https://naukri.example.com

# ============================================================================
# Bearer auth (Claude Code CLI / Claude Desktop)
# ============================================================================

# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Minimum length 32 chars. Anything shorter is rejected at startup.
# Setting this enables bearer-token authentication: clients must send
#   Authorization: Bearer <MCP_SHARED_SECRET>
# Works with Claude Code (--header) and Claude Desktop config.
# Does NOT work with claude.ai web — that needs OAuth (below).
# MCP_SHARED_SECRET=

# ============================================================================
# OAuth provider (Claude.ai web)
# ============================================================================

# Set to 1 to enable the OAuth 2.0 authorization server.
# Required for claude.ai web, which only supports OAuth (no raw bearer header).
# When enabled, MCP_OAUTH_CLIENT_ID and MCP_OAUTH_CLIENT_SECRET are mandatory.
# If MCP_SHARED_SECRET is ALSO set, the same server accepts both auth modes.
MCP_OAUTH_ENABLED=0

# Pre-registered OAuth client credentials.
# These are what you'll paste into claude.ai's "Advanced settings" when adding
# the custom connector.
# Generate a strong secret (>=32 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# MCP_OAUTH_CLIENT_ID=claude-ai-web
# MCP_OAUTH_CLIENT_SECRET=

# Skip the consent screen on /authorize (recommended for single-user setup).
# Set to 0 to render an Approve/Deny page (useful if you're paranoid about
# what client/scopes are being granted).
MCP_OAUTH_AUTO_APPROVE=1

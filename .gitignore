# Browser profile (cookies, session data)
chrome-profile/

# Cross-process profile singleton lock (per-machine runtime PID file)
chrome-profile.lock

# Python
__pycache__/
*.pyc
venv/

# Debug artifacts
debug.png

# Answer cache (contains personal data)
questions.json

# Application tracking data
applications.json
saved_jobs.json

# Optional config overrides
naukri_config.json

# Plan docs (local only)
docs/plans/

# Auth state (sensitive credentials)
auth_state.json

# Remote MCP env file (contains secrets — bearer + OAuth client_secret)
.env

# Sync state
sync_state.json
# Runtime data files in DATA_DIR (the repo root), alongside the already
# ignored applications.json / saved_jobs.json / questions.json.
# reminders.json was TRACKED and carrying rows; untracked 2026-08-21.
# tests/test_no_tree_writes.py keeps this list honest against config.py.
reminders.json
interview_rounds.json

# Early access tracking
early_access_tracking.json

# Exported data
exports/

# Tracking backups
*.backup

# Healer circuit-breaker state (per-machine; should not be committed)
healing_state.json
# Runtime state: the last scoring fingerprint the agent acted under.
# Same class as sync_state.json / healing_state.json / kill_switch_state.json.
agent_policy_state.json

# Kill-switch state (per-machine; should not be committed)
kill_switch_state.json

# Serena
.serena/

# Local SQLite database (per-machine state)
naukri.db
# ...and its WAL sidecars. get_db() sets journal_mode=WAL, so a running server
# leaves naukri.db-wal / -shm beside it; naukri.db alone did not cover them and
# they showed up untracked, one `git add -A` away from committing live DB state.
naukri.db-wal
naukri.db-shm

# Agent config (local, may contain personal preferences)
agent_config.json
# naukri_server/agent_config.json was a SHADOW copy the loader never read
# (CONFIG_PATH is DATA_DIR/agent_config.json and DATA_DIR is the repo root).
# It disagreed with the live file about his autonomy mode. Deleted 2026-08-21.

# OS
.DS_Store
Thumbs.db

# Local backups of live data (never committed)
_backup/

# e2e sweep artifacts - raw captures hold live account data; harness is tracked
_sweep/results*.json
_sweep/verdicts.json
_sweep/final_verdicts.json
_sweep/backup-pre-sweep/
_sweep/*.log
exports/sweep_*.json
_sweep/tools.json
_sweep/livelist.txt
_sweep/backup-pre-sync.db

# ---------------------------------------------------------------------------
# PUBLIC-REPO HYGIENE (2026-08-24)
#
# This repository is world-readable. A private repo forgives a careless
# `git add`; a public one publishes it permanently, and no later push can
# unpublish it. Everything below is a class that has already leaked here once
# or is one command away from doing so.
# ---------------------------------------------------------------------------

# Session and browser state in ANY shape. `chrome-profile/` and
# `auth_state.json` are listed individually above; these are the catch-alls for
# a directory or file some future code path invents. A session cookie in a
# public repo is an account takeover, not a privacy problem.
_state/
state/
*.session
*.cookies
cookies.json
cookies.txt
cookiejar*.json

# mypy's on-disk cache. Three files under `.mypy_cache/3.13/` were TRACKED
# until 2026-08-24. The committed copies happened to hold only an empty schema,
# but a populated cache.db carries the absolute path of every file it analysed,
# which is the machine layout of whoever last ran mypy.
.mypy_cache/
.ruff_cache/
.tox/

# Live API-discovery captures. `probing/` held 22 reports built from real
# responses for the owner's own account: name, date of birth, home address,
# postcode, salary, employer, education, plus two named third-party recruiters.
# It was removed from the tree and from published history on 2026-08-24.
# Re-running a probe is fine; committing the output is not.
probing/

# e2e sweep captures. The policy above ("raw captures hold live account data;
# harness is tracked") was already correct -- but it was written as
# `_sweep/verdicts.json`, and the DATED variants walked straight past it.
# `_sweep/verdicts-2026-08-22.json` reached published history carrying the
# owner's real email address and mobile number. Glob the dates.
_sweep/verdicts*.json
_sweep/final_verdicts*.json
_sweep/results*.json

# Profile snapshots taken before every profile-section write.
# DATA_DIR-relative directory, same class as exports/ - the files hold the
# FULL live profile read (name, phone, employment history) and must never be
# committed. naukri_server/tools/profile_snapshot.py:_SNAPSHOT_DIR.
profile_snapshots/

# Browser profile (cookies, session data)
chrome-profile/

# Cross-process profile singleton lock (per-machine runtime PID file)
chrome-profile.lock

# Python
__pycache__/
*.pyc
venv/

# Debug artifacts
debug.png

# Answer cache (contains personal data)
questions.json

# Application tracking data
applications.json
saved_jobs.json

# Optional config overrides
naukri_config.json

# Plan docs (local only)
docs/plans/

# Auth state (sensitive credentials)
auth_state.json

# Remote MCP env file (contains secrets — bearer + OAuth client_secret)
.env

# Sync state
sync_state.json

# Early access tracking
early_access_tracking.json

# Exported data
exports/

# Tracking backups
*.backup

# Healer circuit-breaker state (per-machine; should not be committed)
healing_state.json

# Kill-switch state (per-machine; should not be committed)
kill_switch_state.json

# Serena
.serena/

# Local SQLite database (per-machine state)
naukri.db

# Agent config (local, may contain personal preferences)
agent_config.json
naukri_server/agent_config.json

# OS
.DS_Store
Thumbs.db

# Local backups of live data (never committed)
_backup/
